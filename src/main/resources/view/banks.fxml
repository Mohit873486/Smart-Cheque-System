<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.*?>

<TabPane tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chequeprint.controller.BankController" style="-fx-background-color: #f8fafc;">

    <!-- ============================================================ -->
    <!-- TAB 1: Bank Accounts — Redesigned                            -->
    <!-- Modern card layout + Cheque Preview panel + Loading + Empty  -->
    <!-- ============================================================ -->
    <Tab text="🏦 Bank Accounts">
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f1f5f9; -fx-background: #f1f5f9;" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER">
            <StackPane style="-fx-background-color: #f1f5f9; -fx-padding: 24;">

                <HBox spacing="20" alignment="TOP_CENTER">

                    <!-- ============== LEFT: Accounts Card ============== -->
                    <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                          styleClass="surface-card">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="2">
                                <Label text="Bank Accounts" styleClass="card-title" />
                                <Label text="Manage your connected bank accounts" styleClass="card-subtitle" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAddAccount" text="＋ Add Account" styleClass="btn-primary" onAction="#onAddAccount" />
                            <Button text="↻ Refresh" onAction="#initialize" styleClass="btn-secondary" />
                        </HBox>

                        <Separator />

                        <!-- Table + overlays -->
                        <StackPane VBox.vgrow="ALWAYS" styleClass="table-frame" minHeight="360">

                            <TableView fx:id="accountTable" VBox.vgrow="ALWAYS" styleClass="clean-table">
                                <columns>
                                    <TableColumn text="Bank Name" prefWidth="200" />
                                    <TableColumn text="Account Number" prefWidth="180" />
                                    <TableColumn text="Account Holder Name" prefWidth="220" />
                                    <TableColumn text="IFSC Code" prefWidth="140" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                            <!-- Empty State Overlay -->
                            <VBox fx:id="emptyState" alignment="CENTER" spacing="10" styleClass="overlay-empty" visible="false" managed="false">
                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" styleClass="empty-icon" scaleX="2.6" scaleY="2.6" />
                                <Label text="No accounts found" styleClass="empty-title" />
                                <Label text="Add a new bank account to get started." styleClass="empty-subtitle" />
                                <Button text="＋ Add your first account" styleClass="btn-primary" onAction="#onAddAccount" />
                            </VBox>

                            <!-- Loading Overlay -->
                            <VBox fx:id="loadingSpinner" alignment="CENTER" spacing="14" styleClass="overlay-loading" visible="false" managed="false">
                                <StackPane styleClass="spinner-ring">
                                    <ProgressIndicator styleClass="spinner-indicator" prefWidth="46" prefHeight="46" />
                                </StackPane>
                                <Label text="Loading accounts…" styleClass="loading-label" />
                            </VBox>

                        </StackPane>

                        <!-- Bottom Table Action Footer: Edit Account (Digit 2) & Delete Account (Digit 3) -->
                        <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                            <Button fx:id="btnEditAccountAction" text="✏ Edit Account" styleClass="btn-secondary" disable="true" onAction="#onEditAccountAction" minWidth="130" />
                            <Button fx:id="btnDeleteAccountAction" text="🗑 Delete Account" styleClass="btn-danger-low" disable="true" onAction="#onDeleteAccountAction" minWidth="140" />
                        </HBox>
                    </VBox>

                    <!-- ============== RIGHT: Cheque Preview Card ============== -->
                    <VBox spacing="16" prefWidth="360" minWidth="360" maxWidth="360" styleClass="surface-card">

                        <VBox spacing="2">
                            <Label text="Cheque Preview" styleClass="card-title" style="-fx-font-size: 18px;" />
                            <Label text="Live preview for the selected account" styleClass="card-subtitle" />
                        </VBox>

                        <Separator />

                        <!-- Preview canvas -->
                        <StackPane styleClass="preview-frame" minHeight="200">

                            <!-- No selection state -->
                            <VBox fx:id="previewEmptyState" alignment="CENTER" spacing="8" visible="true" managed="true">
                                <SVGPath content="M4 6h16v12H4V6zm2 2v8h12V8H6z" styleClass="empty-icon" scaleX="1.6" scaleY="1.6" />
                                <Label text="Select an account" styleClass="empty-subtitle" wrapText="true" textAlignment="CENTER" />
                            </VBox>

                            <!-- Cheque mock preview canvas (rendered dynamically) -->
                            <Pane fx:id="previewPane" styleClass="cheque-mock" visible="false" managed="false" prefWidth="300" prefHeight="170" />

                            <!-- Preview loading overlay -->
                            <VBox fx:id="previewLoading" alignment="CENTER" spacing="10" styleClass="overlay-loading" visible="false" managed="false">
                                <ProgressIndicator styleClass="spinner-indicator" prefWidth="30" prefHeight="30" />
                            </VBox>
                        </StackPane>

                        <Button fx:id="btnEditTemplate" text="Edit Template →" styleClass="btn-secondary" maxWidth="Infinity" onAction="#onEditTemplate" disable="true" />

                    </VBox>

                </HBox>
            </StackPane>
        </ScrollPane>
    </Tab>

    <!-- ============================================================ -->
    <!-- TAB 2: Cheque Designer — Redesigned 2-Panel Layout            -->
    <!-- Left: Field Controls & Inspector | Right: Live Cheque Canvas  -->
    <!-- ============================================================ -->
    <Tab text="🎨 Cheque Designer">
        <BorderPane style="-fx-background-color: #f1f5f9;">

            <!-- ================= LEFT PANEL: Field Controls & Properties ================= -->
            <left>
                <ScrollPane fitToWidth="true" style="-fx-background-color: #ffffff; -fx-border-color: transparent #cbd5e1 transparent transparent; -fx-border-width: 0 1 0 0;"
                            prefWidth="380" minWidth="380" maxWidth="380" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <VBox spacing="16" style="-fx-padding: 18; -fx-background-color: #ffffff;">

                        <!-- Template & Bank Account Selection Header -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 2);">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label fx:id="lblFormTitle" text="Template &amp; Account Settings" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnNewBank" text="+ New" styleClass="btn-primary" onAction="#onClear" visible="false" managed="false" style="-fx-background-radius: 6;" />
                            </HBox>

                            <GridPane hgap="8" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="38" />
                                    <ColumnConstraints percentWidth="62" />
                                </columnConstraints>

                                <Label text="Select Account" style="-fx-text-fill: #475569; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <ComboBox fx:id="cmbBankAccount" promptText="Select bank account" styleClass="form-combo" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                                <Label text="Bank Name" style="-fx-text-fill: #475569;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <ComboBox fx:id="fldBankName" editable="true" promptText="Select bank" styleClass="form-combo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                <Label text="Bank Code" style="-fx-text-fill: #475569;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <TextField fx:id="fldBankCode" promptText="e.g. SBI / HDFC" styleClass="form-input" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                                <Label text="Cheque Size" style="-fx-text-fill: #475569;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <ComboBox fx:id="cmbChequeSize" styleClass="form-combo" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                                <Label text="Size Unit" style="-fx-text-fill: #475569;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                <ComboBox fx:id="cmbChequeSizeUnit" styleClass="form-combo" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                                <Label fx:id="lblCustomWidth" text="Custom W" style="-fx-text-fill: #475569;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                                <TextField fx:id="fldCustomWidth" promptText="203.2" styleClass="form-input" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                                <Label fx:id="lblCustomHeight" text="Custom H" style="-fx-text-fill: #475569;" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                                <TextField fx:id="fldCustomHeight" promptText="92.0" styleClass="form-input" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                                <Label text="MICR Line" style="-fx-text-fill: #475569;" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                                <CheckBox fx:id="chkMicr" selected="true" GridPane.rowIndex="7" GridPane.columnIndex="1" />
                            </GridPane>

                            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                                <Button fx:id="btnSave" text="💾 Save Template" styleClass="btn-primary" onAction="#onSave" maxWidth="Infinity" style="-fx-cursor: hand; -fx-background-radius: 6; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" />
                                <HBox spacing="8">
                                    <Button fx:id="btnClear" text="↻ Reset" styleClass="btn-secondary" onAction="#onClear" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-cursor: hand; -fx-background-radius: 6;" />
                                    <Button fx:id="btnDelete" text="🗑 Delete" styleClass="btn-danger" onAction="#onDelete" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-cursor: hand; -fx-background-radius: 6; -fx-background-color: #ef4444; -fx-text-fill: white;" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Canvas Elements Selector Panel -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 2);">
                            <Label text="Canvas Elements &amp; Layers" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;" />
                            <VBox fx:id="layersContainer" spacing="6">
                                <Button fx:id="layerDate" text="📅 Date Field (D D M M Y Y Y Y)" styleClass="btn-secondary" onAction="#onSelectLayerDate" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                                <Button fx:id="layerPayee" text="📝 Payee Line (Pay To)" styleClass="btn-secondary" onAction="#onSelectLayerPayee" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                                <Button fx:id="layerAmountWords" text="🔤 Amount in Words" styleClass="btn-secondary" onAction="#onSelectLayerAmountWords" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                                <Button fx:id="layerAmountNumber" text="💰 Amount in Figures (₹)" styleClass="btn-secondary" onAction="#onSelectLayerAmountNumber" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                                <Button fx:id="layerSignature" text="✍️ Signature Area" styleClass="btn-secondary" onAction="#onSelectLayerSignature" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                                <Button fx:id="layerBankLogo" text="🏢 Bank Header &amp; Logo" styleClass="btn-secondary" onAction="#onSelectLayerBankLogo" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                                <Button fx:id="layerMicr" text="📊 MICR Band Line" styleClass="btn-secondary" onAction="#onSelectLayerMicr" maxWidth="Infinity" style="-fx-cursor: hand; -fx-alignment: center-left; -fx-padding: 8 12; -fx-background-radius: 6;" />
                            </VBox>
                        </VBox>

                        <!-- Selected Element Field Controls & Inspector -->
                        <VBox spacing="12" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 2);">
                            <Label text="Element Properties" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;" />

                            <VBox spacing="2">
                                <Label text="Active Selected Field:" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
                                <Label fx:id="lblActiveLayerName" text="Click any label to edit" style="-fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-font-size: 13px;" />
                            </VBox>

                            <Separator />

                            <GridPane hgap="8" vgap="10" fx:id="inspectorGrid" disable="true">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="35" />
                                    <ColumnConstraints percentWidth="65" />
                                </columnConstraints>

                                <Label text="X Pos (mm)" style="-fx-text-fill: #475569;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                <TextField fx:id="fldAdjustLeft" promptText="0.0" styleClass="form-input" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                                <Label text="Y Pos (mm)" style="-fx-text-fill: #475569;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                <TextField fx:id="fldAdjustTop" promptText="0.0" styleClass="form-input" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                <Label text="Font Family" style="-fx-text-fill: #475569;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                <ComboBox fx:id="cmbFontFamily" promptText="Arial" styleClass="form-combo" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                                <Label text="Font Size (pt)" style="-fx-text-fill: #475569;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                <TextField fx:id="fldFontSize" promptText="12" styleClass="form-input" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                                <Label text="Field Width" style="-fx-text-fill: #475569;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                                <TextField fx:id="fldAdjustWidth" promptText="auto" styleClass="form-input" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                                <Label text="Field Height" style="-fx-text-fill: #475569;" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                                <TextField fx:id="fldAdjustHeight" promptText="auto" styleClass="form-input" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                                <Label text="Visible" style="-fx-text-fill: #475569;" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                                <CheckBox fx:id="chkFieldVisible" selected="true" style="-fx-cursor: hand;" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                            </GridPane>

                            <HBox spacing="8" alignment="CENTER">
                                <Button text="Reset Field" onAction="#onResetFieldAdjustment" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary" style="-fx-cursor: hand; -fx-background-radius: 6; -fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold;" />
                                <Button text="Apply Changes" onAction="#onApplyFieldAdjustment" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary" style="-fx-cursor: hand; -fx-background-radius: 6; -fx-font-weight: bold;" />
                            </HBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </left>

            <!-- ================= RIGHT PANEL: Live Cheque Preview Workspace ================= -->
            <center>
                <VBox spacing="12" style="-fx-background-color: #f1f5f9; -fx-padding: 18;" VBox.vgrow="ALWAYS">

                    <!-- Canvas Controls Toolbar -->
                    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 2);">
                        <Label fx:id="lblPreviewSize" text="Size: 203.20 x 92.00 mm (Standard Cheque)" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                        <Separator orientation="VERTICAL" />
                        <CheckBox fx:id="chkShowGrid" text="Grid" selected="true" onAction="#onToggleGrid" style="-fx-cursor: hand;" />
                        <CheckBox fx:id="chkSnapGrid" text="Snap to Grid" selected="true" style="-fx-cursor: hand;" />
                        <CheckBox fx:id="chkShowRulers" text="Rulers" selected="true" onAction="#onToggleRulers" style="-fx-cursor: hand;" />
                        <Separator orientation="VERTICAL" />
                        <HBox spacing="6" alignment="CENTER">
                            <Button text="-" onAction="#onZoomOut" styleClass="btn-secondary" style="-fx-background-radius: 4; -fx-padding: 2 8;" />
                            <Label fx:id="lblZoom" text="100%" style="-fx-font-weight: bold; -fx-min-width: 45px; -fx-alignment: center;" />
                            <Button text="+" onAction="#onZoomIn" styleClass="btn-secondary" style="-fx-background-radius: 4; -fx-padding: 2 8;" />
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblCoordinatesHUD" text="Drag any label or click to select" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;" />
                    </HBox>

                    <!-- Interactive Live Cheque Canvas Viewport -->
                    <StackPane fx:id="previewViewport" VBox.vgrow="ALWAYS" style="-fx-background-color: #e2e8f0; -fx-border-color: #cbd5e1; -fx-border-width: 1; -fx-background-radius: 12; -fx-border-radius: 12;">
                        <ScrollPane fx:id="canvasScrollPane" fitToWidth="false" fitToHeight="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                            <StackPane style="-fx-padding: 40;" alignment="CENTER">
                                <Pane fx:id="chequePreviewPane" prefWidth="760" prefHeight="330" style="-fx-background-color: white; -fx-border-color: #94a3b8; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 10);" />
                            </StackPane>
                        </ScrollPane>
                    </StackPane>
                </VBox>
            </center>

        </BorderPane>
    </Tab>
</TabPane>
